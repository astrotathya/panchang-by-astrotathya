{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astrotathya/panchang",
	"title": "Panchang by AstroTathya",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Today's panchang or upcoming Hindu festivals for a city, with local times, in Hindi or English.",
	"keywords": [ "panchang", "tithi", "festival", "hindu calendar", "muhurat" ],
	"textdomain": "panchang-by-astrotathya",
	"attributes": {
		"city": { "type": "string", "default": "" },
		"type": { "type": "string", "default": "" },
		"lang": { "type": "string", "default": "" },
		"theme": { "type": "string", "default": "" },
		"size": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
